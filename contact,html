<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us | Savanna Brew Café</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>

<header class="cafe-header">
    <div class="logo">
        SAVANNA BREW <span>CAFÉ</span>
    </div>

    <nav>
        <a href="index.html">Home</a>
        <a href="about.html">About Us</a>
        <a href="menu.html">Menu</a>
        <a href="gallery.html">Gallery</a>
        <a href="contact.html" class="active">Contact</a>
    </nav>
</header>

<section class="hero">
    <div class="hero-content">
        <p class="hero-subtitle">WE WOULD LOVE TO HEAR FROM YOU</p>
        <h1>Contact Us</h1>
        <p>Visit us, ask a question or book a table.</p>
    </div>
</section>

<section class="contact-section">

    <div class="section-heading">
        <h2>Get in Touch</h2>
        <p>We look forward to welcoming you to Savanna Brew Café.</p>
    </div>

    <div class="contact-container">

        <div class="contact-details">
            <h3>Visit Our Café</h3>

            <p><strong>Location</strong></p>
            <p>Westlands, Nairobi, Kenya</p>

            <p><strong>Our Café</strong></p>
            <p>Enjoy freshly prepared coffee and delicious baked treats in a welcoming atmosphere.</p>

            <p><strong>Table Bookings</strong></p>
            <p>Use the form to request a table reservation.</p>
        </div>

        <form class="booking-form"
        onsubmit="event.preventDefault(); alert('Thank you for your request! Please contact the café directly to confirm your booking.');">

            <h3>Book a Table</h3>

            <label for="name">Full Name</label>
            <input type="text" id="name" name="name" required>

            <label for="email">Email Address</label>
            <input type="email" id="email" name="email" required>

            <label for="phone">Phone Number</label>
            <input type="tel" id="phone" name="phone">

            <label for="guests">Number of Guests</label>
            <select id="guests" name="guests" required>
                <option value="">Select guests</option>
                <option>1</option>
                <option>2</option>
                <option>3</option>
                <option>4</option>
                <option>5</option>
                <option>6 or more</option>
            </select>

            <label for="date">Preferred Date</label>
            <input type="date" id="date" name="date" required>

            <label for="time">Preferred Time</label>
            <input type="time" id="time" name="time" required>

            <label for="message">Additional Message</label>
            <textarea id="message" name="message" rows="4"></textarea>

            <button type="submit" class="btn">Send Booking Request</button>

        </form>

    </div>
</section>

<footer class="footer">
    <h2>SAVANNA BREW CAFÉ</h2>
    <p>Fresh coffee. Fresh moments. Warm memories.</p>
    <p>Westlands, Nairobi, Kenya</p>
    <p>&copy; 2026 Savanna Brew Café. All Rights Reserved.</p>
</footer>

</body>
</html>
